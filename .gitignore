# --- Secrets: real MCP bearer tokens + ANTHROPIC_API_KEY live here ---
# provision.sh writes per-user tokens into agent/.env; never commit it.
.env
*.env
!*.env.example
agent/.env

# --- Python / uv virtual env and caches ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Generated test artifacts (regenerated by rbac_test.py --with-llm) ---
agent/transcripts/

# --- Vendor add-on package (proprietary Splunk binary; place it here locally) ---
# Required at repo root for `docker compose up`, but not redistributed via git.
splunk-mcp-server_*.tgz
*.tgz

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
