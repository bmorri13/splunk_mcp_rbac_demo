# Template for agent/.env — copy to agent/.env and fill in.
#
# NOTE: provision/provision.sh writes SPLUNK_MCP_URL and the three MCP_TOKEN_*
# values automatically (minting one bearer token per user). You normally only
# add ANTHROPIC_API_KEY yourself. Never commit the real agent/.env — it is
# gitignored because the MCP_TOKEN_* values are live Splunk credentials.

# MCP endpoint on the splunkd management port (set by provision.sh)
SPLUNK_MCP_URL=https://localhost:8089/services/mcp

# Per-user RSA-encrypted Splunk MCP tokens (written by provision.sh).
# These are secrets — placeholders shown here.
MCP_TOKEN_ALICE=<minted-by-provision.sh>
MCP_TOKEN_BOB=<minted-by-provision.sh>
MCP_TOKEN_ADMIN=<minted-by-provision.sh>

# Your Anthropic API key, for the LLM-driven agent (rbac_test.py --with-llm,
# splunk_agent.py). Add this yourself.
ANTHROPIC_API_KEY=sk-ant-...
